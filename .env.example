# ==============================================================================
# KOD Technical Services — Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit real secret keys.
# ==============================================================================

# Application URL (Development: http://localhost:3000 | Production: https://kodtechnical.vercel.app)
NEXT_PUBLIC_SITE_URL=https://kodtechnical.vercel.app
SITE_URL=https://kodtechnical.vercel.app

# ------------------------------------------------------------------------------
# Server-Side RFQ & Email Delivery Configuration (Chapter 8)
# Provider: Resend (https://resend.com)
# ------------------------------------------------------------------------------
# Resend API Key (starts with re_)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified Sending Domain / Sender Address (must be verified on your Resend dashboard)
# Example: "KOD Engineering Desk <quotes@kodtechnical.com>" or "onboarding@resend.dev" for sandbox
RFQ_SENDER_EMAIL="KOD Engineering Desk <quotes@kodtechnical.com>"

# Destination Inbox for Client Quotes and Inquiries
RFQ_RECIPIENT_EMAIL=info@kodtechnical.com

# Mock Delivery Mode: Set to "true" in dev/staging/CI to simulate delivery without calling Resend API
RFQ_MOCK_DELIVERY=false

# ------------------------------------------------------------------------------
# Distributed Rate Limiting (Upstash Redis REST API)
# Provider: Upstash Redis (https://upstash.com)
#
# PRODUCTION NOTICE:
# The built-in in-process fallback rate limiter is strictly intended for local dev,
# single-instance servers, and CI. In multi-instance serverless environments
# (e.g., Vercel, AWS Lambda, Google Cloud Run), each cold start initializes an
# isolated in-memory counter, making the fallback ineffective against distributed abuse.
# For production deployments, you MUST configure UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN to enable shared, edge-wide distributed rate limiting.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
